# Server-side AI provider configuration.
# Copy this file to .env.local for local development, or set these variables
# directly in the deployment environment. Do not expose these keys to the browser.

AI_WRITER_BASE_URL=
AI_WRITER_API_KEY=
AI_WRITER_MODEL=

AI_PLANNER_BASE_URL=
AI_PLANNER_API_KEY=
AI_PLANNER_MODEL=

AI_SUMMARY_BASE_URL=
AI_SUMMARY_API_KEY=
AI_SUMMARY_MODEL=

AI_MEMORY_BASE_URL=
AI_MEMORY_API_KEY=
AI_MEMORY_MODEL=

AI_DIAGNOSIS_BASE_URL=
AI_DIAGNOSIS_API_KEY=
AI_DIAGNOSIS_MODEL=

# Independent LLM Judge for A/B/C evaluation. Prefer a provider/model different from AI_WRITER.
AI_EVALUATION_JUDGE_BASE_URL=
AI_EVALUATION_JUDGE_API_KEY=
AI_EVALUATION_JUDGE_MODEL=

# Optional second-pass blind auditor for character importance. Use a separate provider/model from AI_DIAGNOSIS.
AI_CHARACTER_AUDITOR_BASE_URL=
AI_CHARACTER_AUDITOR_API_KEY=
AI_CHARACTER_AUDITOR_MODEL=qwen-plus

# Local PostgreSQL + pgvector. Keep this only in .env.local.
DATABASE_URL=postgresql://ai_novel:change-me@127.0.0.1:5432/ai_novel
POSTGRES_PASSWORD=change-me

# Server-side embedding configuration for RAG. Do not expose the key to the browser.
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=qwen3.7-text-embedding
AI_EMBEDDING_DIMENSIONS=1024

# Local default keeps the app private to the current machine.
# For Docker or direct server exposure behind a firewall/reverse proxy, use HOST=0.0.0.0.
HOST=127.0.0.1
PORT=3000
