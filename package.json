{
  "name": "ai-creation-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "start:site": "node scripts/start-dev-detached.cjs",
    "serve:site": "node scripts/site-service.cjs",
    "install:startup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows-startup.ps1",
    "build": "next build",
    "test": "vitest",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file=.env.local scripts/migrate-db.mjs"
    ,"export:public": "node scripts/export-public-release.mjs"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "next": "^16.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "@types/node": "^24.8.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.2"
  }
}
